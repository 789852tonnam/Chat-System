# OpenAI-compatible API configuration. Copy to .env and replace the example key.

# Base URL only; the application appends /chat/completions.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model ID served by the configured API.
OPENAI_MODEL=openrouter/free

# Example only. Put your actual API key in .env.
OPENAI_API_KEY=your_api_key_here
