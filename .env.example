# Copy this file to .env and replace the example API key.

# Full chat completions endpoint, including /chat/completions.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Free model router; replace with a specific model ID if needed.
OPENROUTER_MODEL=openrouter/free

# Example only. Put your actual API key in .env.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-api-key
